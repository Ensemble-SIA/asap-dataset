#!/bin/sh
#
# asap-dataset — pre-commit shim. THE GATES ARE NOT HERE.
#
# Every corpus gate lives ONCE, in the ensemble repo at scripts/corpus_gates.py,
# parameterized by this repo's declared shape. This file only points at it, so it
# carries nothing that can drift. Do NOT edit or copy logic here: the canonical
# copy is that repo's scripts/corpus_gate_shims/asap-dataset.pre-commit, and
# tests/architecture/test_corpus_gate_shims.py fails the ensemble build the moment
# this hook stops matching it byte for byte.
#
# This file IS the control. .git/hooks is not versioned, so the hook lives here
# and is activated with:
#
#     git config core.hooksPath githooks
#
# No silent skips: an unreachable ensemble repo or a missing interpreter REFUSES
# with the reason. A gate that cannot run is never a gate that passed.

set -u

ENSEMBLE_REPO="${ENSEMBLE_REPO:-/Users/george/Projects/ensemble}"
[ -d "$ENSEMBLE_REPO" ] || { printf '\n[pre-commit] COMMIT REFUSED\n  the ensemble repo is not at: %s\n  That is where the corpus gates live, so nothing staged here can be judged.\n  Set ENSEMBLE_REPO to the repo path and retry.\n\n' "$ENSEMBLE_REPO" >&2; exit 1; }

# The ensemble venv's interpreter is preferred because it is the one the repo's
# own tooling runs; a system python3 is the declared alternative. Neither present
# refuses — the gates are stdlib-only, so a missing interpreter means the machine
# is broken, not that the commit is clean.
PY="$ENSEMBLE_REPO/.venv/bin/python3"
[ -x "$PY" ] || PY=$(command -v python3 || printf '')
[ -n "$PY" ] || { printf '\n[pre-commit] COMMIT REFUSED\n  no python3 interpreter found (looked at $ENSEMBLE_REPO/.venv/bin/python3 and PATH).\n  The corpus gates cannot run, so the commit is refused rather than passed.\n\n' >&2; exit 1; }

exec "$PY" "$ENSEMBLE_REPO/scripts/corpus_gates.py" --repo asap-dataset --reset-wave "${RESET_WAVE:-}" "$@"
